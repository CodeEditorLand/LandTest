{
	"compilerOptions": {
		"alwaysStrict": true,
		"baseUrl": "./",
		"declaration": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ES2021"
		],
		"module": "Node16",
		"moduleResolution": "Node16",
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"outDir": "Target",
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2021"
	},
	"exclude": [
		"node_modules"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"lib",
		"src",
		"src",
		"src"
	]
}
