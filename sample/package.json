{
  "name": "vscode-test-sample",
  "displayName": "vscode-test-sample",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.32.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.helloWorld"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "cd .. && tsc && cd sample && tsc && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "@types/vscode": "^1.100.0",
    "glob": "^11.0.2",
    "mocha": "^11.6.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {}
}
